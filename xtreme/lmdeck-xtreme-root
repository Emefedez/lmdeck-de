#!/bin/sh
# lmdeck XTreme mode: the only steps it needs root for (sudoers.d/lmdeck-xtreme allows exactly these arguments).
set -eu
fb=/sys/class/graphics/fb0/blank
bl=/sys/class/backlight/apple-panel-bl/bl_power
bat=/sys/class/power_supply/macsmc-battery/charge_control_end_threshold
kbd=/sys/class/leds/kbd_backlight/brightness
# the keyboard's brightness while the panel is off (restored with the panel)
kbd_saved=/run/lmdeck-xtreme-kbd
# The wall's console: above the six that logind gives gettys (NAutoVTs), so nothing else claims it.
vt=8
# sudo passes the arguments one by one; the rule matches them as one string, and so does this
case "$*" in
  desktop-stop)  exec /usr/bin/systemctl stop sddm.service ;;
  desktop-start)
    # SDDM takes its own VT; the wall's console goes with the run.
    /usr/bin/systemctl stop lmdeck-xtreme-wall.service 2>/dev/null || true
    exec /usr/bin/systemctl start sddm.service ;;
  # panel off through the console's framebuffer (DRM fbdev blank, 4 = powerdown); the backlight too, in case the
  # blank alone leaves it lit
  # (and the keyboard's backlight off with it, back as it was with it)
  screen-off)
    echo 4 > "$fb" 2>/dev/null || true; [ -w "$bl" ] && echo 4 > "$bl"
    if [ -w "$kbd" ] && [ ! -e "$kbd_saved" ]; then cat "$kbd" > "$kbd_saved"; echo 0 > "$kbd"; fi
    exit 0 ;;
  screen-on)
    [ -w "$bl" ] && echo 0 > "$bl"; echo 0 > "$fb" 2>/dev/null || true
    if [ -e "$kbd_saved" ]; then cat "$kbd_saved" > "$kbd" 2>/dev/null || true; rm -f "$kbd_saved"; fi
    exit 0 ;;
  # the wall on a console of its own, as the user who ran sudo, with the Terminus 16x32 font (that console only)
  wall)
    u="${SUDO_USER:?run through sudo}"
    h=$(getent passwd "$u" | cut -d: -f6)
    exe="$h/.local/bin/lmdeck"
    [ -x "$exe" ] || exe=/usr/bin/lmdeck
    /usr/bin/setfont -C "/dev/tty$vt" ter-132n 2>/dev/null || true
    # The brightness and keyboard-light keys mean nothing on a text console: give them F13-F16, which the console
    # sends as ordinary escape sequences, so the wall reads them as keys (no input-device listener). Only these four
    # keycodes change, and only for the text consoles; the desktop reads the keyboard itself.
    printf 'keycode 224 = F13\nkeycode 225 = F14\nkeycode 229 = F15\nkeycode 230 = F16\n' > /run/lmdeck-xtreme.keymap
    /usr/bin/loadkeys -C "/dev/tty$vt" /run/lmdeck-xtreme.keymap >/dev/null 2>&1 || true
    # a system unit of its own, so the wall outlives whoever started it (lmdeck's service restarting included)
    if ! /usr/bin/systemctl is-active --quiet lmdeck-xtreme-wall.service; then
      /usr/bin/systemd-run --quiet --unit=lmdeck-xtreme-wall --collect --uid="$u" --gid="$(id -g "$u")" \
        -p TTYPath="/dev/tty$vt" -p StandardInput=tty-force -p StandardOutput=tty -p StandardError=journal \
        -p TTYReset=yes -p TTYVHangup=yes -p WorkingDirectory="$h" \
        -E HOME="$h" -E USER="$u" -E LOGNAME="$u" -E TERM=linux -E LANG="${LANG:-C.UTF-8}" \
        -E PATH="$h/.local/bin:/usr/local/bin:/usr/bin" -E XDG_RUNTIME_DIR="/run/user/$(id -u "$u")" \
        -E DBUS_SESSION_BUS_ADDRESS="unix:path=/run/user/$(id -u "$u")/bus" \
        "$exe" xtreme wall
    fi
    exec /usr/bin/chvt "$vt" ;;
  # away mode: Tailscale only while away, and to the tailnet only the model APIs (Ollama /api, OpenAI and Anthropic
  # /v1); lmdeck's control API (/lmdeck/*, which can change settings and run hooks) stays on localhost
  remote-on)
    /usr/bin/systemctl start tailscaled.service
    /usr/bin/tailscale up >/dev/null 2>&1 || true
    /usr/bin/tailscale serve --bg --http=11434 --set-path=/v1 http://127.0.0.1:11434/v1
    exec /usr/bin/tailscale serve --bg --http=11434 --set-path=/api http://127.0.0.1:11434/api ;;
  remote-off)
    /usr/bin/tailscale serve reset 2>/dev/null || true
    exec /usr/bin/systemctl stop tailscaled.service ;;
  # a server run: let other computers reach lmdeck's network listener (model APIs only, behind its token)
  "lan-on "[0-9]*|"lan-off "[0-9]*)
    port="${2:-}"
    case "$port" in ''|*[!0-9]*) echo "bad port" >&2; exit 2 ;; esac
    if [ -x /usr/bin/ufw ] && /usr/bin/ufw status | grep -q "^Status: active"; then
      if [ "$1" = lan-on ]; then
        exec /usr/bin/ufw allow in proto tcp to any port "$port" comment "lmdeck xtreme"
      else
        exec /usr/bin/ufw delete allow in proto tcp to any port "$port"
      fi
    fi
    exit 0 ;;
  "battery-limit 80") echo 80 > "$bat" ;;
  "battery-limit 100") echo 100 > "$bat" ;;
  # systemd's runtime watchdog (/dev/watchdog0): a hung machine reboots after 60 s; off again on stop
  watchdog-on)  exec /usr/bin/busctl set-property org.freedesktop.systemd1 /org/freedesktop/systemd1 org.freedesktop.systemd1.Manager RuntimeWatchdogUSec t 60000000 ;;
  watchdog-off) exec /usr/bin/busctl set-property org.freedesktop.systemd1 /org/freedesktop/systemd1 org.freedesktop.systemd1.Manager RuntimeWatchdogUSec t 0 ;;
  *) echo "usage: lmdeck-xtreme-root desktop-stop|desktop-start|screen-off|screen-on|wall|remote-on|remote-off|'battery-limit 80|100'|watchdog-on|watchdog-off|'lan-on|lan-off PORT'" >&2; exit 2 ;;
esac
